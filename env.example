# =============================================================================
# TRADING SHEET APPLET - LOCAL DEVELOPMENT ENVIRONMENT EXAMPLE
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to the repository
# 
# To use:
#   cp env.example .env
#   nano .env  # Edit with your actual credentials
#   set -a; source .env; set +a
#   ./entrypoint.sh streamlit run app/main.py
#
# IMPORTANT: The template no longer has default values.
# ALL variables must be set, or the container will fail to start.
# =============================================================================

# -----------------------------------------------------------------------------
# Startup Configuration (REQUIRED)
# -----------------------------------------------------------------------------
STRICT_STARTUP=false              # Set to "true" to enforce all validations (REQUIRED in production)
OVERWRITE_SECRETS=true            # Set to "true" to regenerate secrets.toml (REQUIRED for container startup)

# -----------------------------------------------------------------------------
# Email Configuration (REQUIRED for audit trail)
# -----------------------------------------------------------------------------
EMAIL_ADDRESS=your-email@gmail.com                    # REQUIRED: Sender email address
EMAIL_APP_PASSWORD=your-app-password                  # REQUIRED: Gmail app-specific password (from Vault)
EMAIL_NOTIFICATION_ADDRESS=don.kruger123@gmail.com    # REQUIRED: Audit email recipient
EMAIL_RECIPIENT_ADDRESS=don.kruger123@gmail.com       # REQUIRED: Backward compatibility (same as notification)
EMAIL_SMTP_SERVER=smtp.gmail.com                      # REQUIRED: SMTP server

# -----------------------------------------------------------------------------
# LLM API (REQUIRED but can be empty string)
# -----------------------------------------------------------------------------
LLM_GEMINI_API_KEY=your-gemini-api-key-here           # REQUIRED: Gemini API key (set to empty string if not using)

# -----------------------------------------------------------------------------
# Trade Allocations API (REQUIRED for core functionality)
# -----------------------------------------------------------------------------
TRADE_API_ENVIRONMENT=uat                               # REQUIRED: Options: uat, qa, prod
TRADE_API_KEY=your-api-key-here                         # REQUIRED: Bearer token (from Vault)

# UAT URLs (REQUIRED)
TRADE_API_UAT_BASE_URL=https://tradeallocationsapi.purple-uat.easyequities.io
TRADE_API_UAT_MONITOR_URL=https://trade-allocations-monitor.purple-uat.easyequities.io

# QA URLs (REQUIRED)
TRADE_API_QA_BASE_URL=https://tradeallocationsapi.purple-qa.easyequities.io
TRADE_API_QA_MONITOR_URL=https://trade-allocations-monitor.purple-qa.easyequities.io

# Production URLs (REQUIRED)
TRADE_API_PROD_BASE_URL=https://tradeallocationsapi.easyequities.io
TRADE_API_PROD_MONITOR_URL=https://trade-allocations-monitor.easyequities.io

# System configuration (REQUIRED)
TRADE_API_SYSTEM_ID=27                                  # REQUIRED: Your application's system ID
TRADE_API_TIMEOUT=30                                    # REQUIRED: API request timeout in seconds
TRADE_API_MAX_RETRIES=3                                 # REQUIRED: Maximum retry attempts
TRADE_API_POLLING_INTERVAL=5                            # REQUIRED: Seconds between status checks
TRADE_API_MAX_POLLING_DURATION=300                      # REQUIRED: Maximum time to poll (5 minutes)
TRADE_API_DEFAULT_TRADER_ID=45314                       # REQUIRED: Default trader ID

# -----------------------------------------------------------------------------
# Trade Protection (REQUIRED - Security settings)
# -----------------------------------------------------------------------------
TRADE_PROTECTION_BLOCK_NON_UT=true                      # REQUIRED: Enable UT-only protection
TRADE_PROTECTION_PREFIX_1=UT.ZA                         # REQUIRED: Allowed contract prefix
TRADE_PROTECTION_MODE=strict                            # REQUIRED: Options: strict, audit_warn
TRADE_PROTECTION_AUDIT_ALL=true                         # REQUIRED: Log all validations
TRADE_PROTECTION_ALLOW_OVERRIDE=false                   # REQUIRED: Allow overrides (false in production)
TRADE_PROTECTION_MAX_ATTEMPTS=3                         # REQUIRED: Max validation attempts

# -----------------------------------------------------------------------------
# Authentication Configuration (REQUIRED)
# -----------------------------------------------------------------------------
AUTH_PROVIDER=secrets                                   # REQUIRED: Options: secrets, oauth, ldap, database
AUTH_SESSION_TIMEOUT=60                                 # REQUIRED: Session timeout in minutes
AUTH_INACTIVITY_TIMEOUT=30                              # REQUIRED: Inactivity timeout in minutes
AUTH_MAX_LOGIN_ATTEMPTS=5                               # REQUIRED: Max failed login attempts
AUTH_LOCKOUT_DURATION=15                                # REQUIRED: Lockout duration in minutes
AUTH_LOG_ATTEMPTS=true                                  # REQUIRED: Log all login attempts
AUTH_LOG_FAILED_ONLY=false                              # REQUIRED: Log only failed attempts

# -----------------------------------------------------------------------------
# Admin Users (REQUIRED - MVP bcrypt hashed passwords)
# -----------------------------------------------------------------------------
# Format: USERS_ADMIN_<IDENTIFIER> = "email|name|password_hash|role|enabled"
# Generate hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'YourPassword', bcrypt.gensalt()).decode())"
# 
# CRITICAL - DO NOT ADD QUOTES AROUND THE VALUE:
#   ✓ CORRECT (for .env file with escaping):
#     USERS_ADMIN_USER_1="email|name|\$2b\$12\$abc...|admin|true"
#   ✓ CORRECT (for .env file with single quotes, no escaping):
#     USERS_ADMIN_USER_1='email|name|$2b$12$abc...|admin|true'
#   ✗ WRONG (extra quotes become part of value):
#     USERS_ADMIN_USER_1="'email|name|$2b$12$abc...|admin|true'"
#
# For Vault/Secrets Manager: Store WITHOUT any quotes at all
#   CORRECT: email|name|$2b$12$abc...|admin|true
# -----------------------------------------------------------------------------

# REQUIRED: At least one admin user must be configured
USERS_ADMIN_USER_1='user@example.com|User Name|$2b$12$REPLACE_WITH_ACTUAL_BCRYPT_HASH|admin|true'

# Optional: Additional users
# USERS_ADMIN_USER_2='user2@example.com|User Two|$2b$12$YOUR_HASH_HERE|admin|true'
